{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "paths": {
      "@banto/core": ["../banto-core/src/index.ts"],
      "@banto/repo-manager": ["../banto-repo-manager/src/index.ts"]
    }
  },
  "references": [
    { "path": "../banto-core" },
    { "path": "../banto-repo-manager" }
  ],
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
