---
// ランディングページ（Starlight の外）。
// 構成は同種の製品サイトの調査（2026-10-14：Conductor・Cursor・Linear・Zed・Vibe Kanban）から：
// 本物の画面写真を大きく見せる・コマンドをすぐコピーできる・「なぜ作ったか」を語る・機能ごとに文と画面を交互に並べる・FAQ。
// 画面写真は src/assets/screens/（本物の banto を試験用の偽 AI で動かして撮る。site/README.md）。
// 色は banto の画面と同じ藍（#3b5bdb）を軸にし、朱（#ce4620）は「あなたの番」にだけ使う。
import '../styles/fonts.css';
import mark from '../assets/mark.svg?url';
import Screen from '../components/Screen.astro';

const installCmd = 'curl -fsSL https://banto.tjst-t.dev/install.sh | bash -s -- --domain banto.example.com';
const title = 'banto — AI エージェントとの並行開発のためのワークスペース';
const description =
	'banto は、複数の AI エージェントに並行して作業を任せても、進捗と確認待ちをひと目で把握できるセルフホスト型のワークスペースです。';

const faqs = [
	{
		q: 'どの AI を使いますか？',
		a: '会話には Claude（Claude Code）を使います。banto をインストールしたサーバーで Claude Code にログインしておくと、そのアカウントで動作します。サブエージェントとして OpenCode を使うこともできます。',
	},
	{
		q: 'Windows や Mac でも使えますか？',
		a: 'banto 本体は Ubuntu 24.04 または 26.04 のサーバーで動作します。操作はブラウザから行うので、Windows・Mac・スマートフォンなど、手元の端末は問いません。仮想マシンにインストールすることもできます。',
	},
	{
		q: 'AI が誤ってファイルを消したりしませんか？',
		a: 'AI の操作はプロジェクトごとのコンテナの中で行われ、ほかのプロジェクトやサーバー本体のファイルには届きません。危険な操作は実行前に承認を求めるように設定できます。',
	},
	{
		q: 'データはどこに保存されますか？',
		a: '会話の履歴・設定・シークレットなどは、すべて banto をインストールしたサーバーに保存されます。外部に送信されるのは、AI との会話の内容（Claude の API）と、ご自身で設定した連携先への通信だけです。',
	},
	{
		q: '外出先から使えますか？',
		a: 'banto の画面はブラウザから HTTPS で利用でき、スマートフォンにも対応しています。インターネットに直接公開するのではなく、Tailscale などの VPN を経由して利用することをおすすめします。',
	},
	{
		q: '複数人で使えますか？',
		a: '現在は1人で使うことを前提にしています。複数人での共同利用には対応していません。',
	},
];
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://banto.tjst-t.dev/" />
		<meta name="theme-color" content="#f5f6f8" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
	</head>
	<body>
		<header class="top">
			<div class="wrap top-inner">
				<a class="brand" href="/">
					<img src={mark} alt="" width="26" height="26" />
					<span>banto</span>
				</a>
				<nav aria-label="サイト">
					<a href="/docs/">ドキュメント</a>
					<a href="/docs/quickstart/">クイックスタート</a>
					<a href="https://github.com/tjst-t/banto">GitHub</a>
					<a class="nav-cta" href="/docs/install/">インストール</a>
				</nav>
			</div>
		</header>

		<main>
			<section class="hero wrap">
				<p class="kicker">AI エージェントとの開発のためのセルフホスト型ワークスペース</p>
				<!-- 見出しの案（検討中）。?v=b などで切り替えて見比べる。決まったら他の案と切り替えの仕組みを消す -->
				<div class="variant" data-v="a">
					<h1><span class="nb">AI と開発する環境を、</span><span class="nb">まるごとひとつに。</span></h1>
					<p class="lead">
						会話の管理から、コマンドの実行、ブラウザでの確認、シークレットの管理、サーバーの公開、タスクの自動実装まで。banto は、AI エージェントとの開発に必要なものをひとつにまとめたワークスペースです。作業をいくつ並行させても、進行中のものと判断待ちのものがひと目でわかります。
					</p>
				</div>
				<div class="variant" data-v="b" hidden>
					<h1><span class="nb">依頼から公開まで、</span><span class="nb">AI との開発をひとつの場所で。</span></h1>
					<p class="lead">
						banto は、AI エージェントへの依頼、実行環境、ツール、進捗の管理をひとつにまとめたセルフホスト型のワークスペースです。開発サーバーの起動も、ブラウザでの確認も、main へのマージも、banto の中で任せられます。
					</p>
				</div>
				<div class="variant" data-v="c" hidden>
					<h1><span class="nb">AI に任せる開発の、</span><span class="nb">司令塔と道具箱。</span></h1>
					<p class="lead">
						並行する作業の状況をひと目で把握できる画面と、AI がそのまま使える開発ツール一式。banto は、AI エージェントとの開発に必要なものをひとつにまとめたセルフホスト型のワークスペースです。
					</p>
				</div>
				<div class="variant" data-v="d" hidden>
					<h1><span class="nb">「どこまで進んだっけ」を、</span><span class="nb">ゼロに。</span></h1>
					<p class="lead">
						banto は、AI エージェントに任せた作業をプロジェクトと会話ごとに整理し、開発に必要なツールもひとつにまとめたワークスペースです。進行中の作業も、あなたの判断を待っている作業も、ひとつの画面でわかります。
					</p>
				</div>
				<div class="actions">
					<a class="btn primary" href="/docs/install/">インストール手順を見る</a>
					<button type="button" class="cmd-chip" data-copy={installCmd} aria-label="インストールコマンドをコピー">
						<span class="prompt">$</span>
						<code>curl -fsSL https://banto.tjst-t.dev/install.sh | bash</code>
						<span class="copy-label">コピー</span>
					</button>
				</div>
				<div class="included" aria-label="banto に含まれるもの">
					<p class="included-label">これひとつで</p>
					<ul>
						<li>会話と Fork</li>
						<li>受信箱と承認</li>
						<li>コマンド実行</li>
						<li>ターミナル</li>
						<li>ブラウザ</li>
						<li>シークレット管理</li>
						<li>開発サーバーの公開</li>
						<li>リポジトリ管理</li>
						<li>バックログ</li>
						<li>自動実装（Factory）</li>
						<li>サブエージェント</li>
						<li>コンテナによる隔離</li>
					</ul>
				</div>
			</section>

			<section class="stage stage-hero" aria-label="banto の画面">
				<div class="wrap-wide">
					<Screen name="hero" alt="banto の画面。サイドバーに複数のプロジェクトと会話が並び、作業中・判断待ち・未読の状態が表示されている" eager />
				</div>
			</section>

			<section class="why wrap">
				<h2 class="why-title">
					並行して走らせるほど、<br />追いかける手間が増えていく。
				</h2>
				<div class="why-body">
					<p>
						AI エージェントに作業を任せると、待ち時間が生まれます。その間に別の作業を頼み、別のプロジェクトにも手を付ける。気がつくと、どのターミナルで何を頼んだのか、どれが自分の返事を待っているのかを覚えておくこと自体が、新しい仕事になっています。
					</p>
					<p>
						banto は、この「追いかける手間」をなくすために作りました。プロジェクトと会話を一覧にまとめ、AI が作業中のもの・あなたの判断を待っているもの・まだ読んでいない返信を、サイドバーと受信箱で常に見えるようにします。並行する作業の数を増やしても、覚えておくべきことは増えません。
					</p>
				</div>
			</section>

			<section class="feature wrap">
				<div class="feature-text">
					<h2>確認待ちが、ひと目でわかる</h2>
					<p>
						AI からの承認依頼や判断の依頼は、受信箱に集まります。項目を選ぶと、該当する会話のその場所が開きます。判断待ちの件数は受信箱に表示され、サイドバーでは AI が作業中の会話のアイコンが回ります。
					</p>
					<ul>
						<li>開いていないプロジェクトの状態も、サイドバーでわかる</li>
						<li>バックグラウンドで動いている処理の件数も表示</li>
						<li>未読の返信がある会話は太字で表示</li>
					</ul>
					<a class="more" href="/docs/guide/inbox/">受信箱と承認について</a>
				</div>
				<div class="feature-shot">
					<Screen name="inbox" alt="受信箱を開いた画面。判断待ち・レビュー待ち・通知が並んでいる" />
				</div>
			</section>

			<section class="feature wrap reverse">
				<div class="feature-text">
					<h2>会話を分岐させて、複数の案を同時に試す</h2>
					<p>
						会話は Fork で分岐できます。同じ依頼から2つの実装方針を並行して進めたり、本題を止めずに別の調査を切り出したりできます。どの会話から分岐したかは構造として残るので、作業の経緯を見失いません。
					</p>
					<ul>
						<li>それまでの会話を引き継ぐか、新しく始めるかを選べる</li>
						<li>AI が自分で Fork を作って作業を分担することも</li>
						<li>決定事項は Memory に記録され、どの Fork にも引き継がれる</li>
					</ul>
					<a class="more" href="/docs/guide/threads/">会話と Fork について</a>
				</div>
				<div class="feature-shot">
					<Screen name="fork" alt="同じプロジェクトで2つの Fork を並行して進めている画面" />
				</div>
			</section>

			<section class="feature wrap">
				<div class="feature-text">
					<h2>重要な操作は、承認してから実行</h2>
					<p>
						コマンドの実行やファイルの書き換えなど、確認したい操作は会話の中にカードとして表示されます。内容を確認して、許可するか拒否するかを選ぶだけです。AI が選択肢つきで判断を求めてきたときも、ボタンを押せばそのまま回答が送られます。
					</p>
					<ul>
						<li>確認の要否は、会話ごとに切り替え可能</li>
						<li>プロジェクト単位で「すべて自動で許可」にも設定できる</li>
						<li>シークレットの値は、AI のコンテキストに一切含まれない</li>
					</ul>
					<a class="more" href="/docs/guide/inbox/#承認">承認のしくみ</a>
				</div>
				<div class="feature-shot">
					<Screen name="approval" alt="会話の中に表示された承認カード" frame={false} ratio="4 / 3" />
				</div>
			</section>

			<section class="feature wrap reverse">
				<div class="feature-text">
					<h2>開発に必要なツールを、最初から</h2>
					<p>
						コマンドの実行、ファイル操作、ブラウザ、シークレットの管理、開発サーバーの起動と公開。開発で使うツールはモジュールとして組み込まれていて、AI も人も同じものを操作します。AI が開いた画面を、人がそのまま引き継いで操作することもできます。
					</p>
					<a class="more" href="/docs/modules/">モジュール一覧</a>
				</div>
				<div class="feature-shot">
					<Screen name="module" alt="モジュールの画面を開いたところ" />
				</div>
			</section>

			<section class="modules wrap" aria-label="主なモジュール">
				<dl>
					<div><dt>Shell</dt><dd>コンテナ内でコマンドを実行。時間のかかる処理はバックグラウンドで動かし、終わったら AI に通知します。</dd></div>
					<div><dt>Browser</dt><dd>コンテナ内のブラウザ。AI が操作している画面を、人も同じように見て操作できます。</dd></div>
					<div><dt>Terminal</dt><dd>人が使うターミナル。画面を閉じてもセッションは残ります。</dd></div>
					<div><dt>Vault</dt><dd>API トークンや SSH 鍵を保管。AI には参照名だけを渡します。</dd></div>
					<div><dt>Service・Publish</dt><dd>開発サーバーを常駐させ、ログイン付きの URL で公開します。</dd></div>
					<div><dt>Repositories</dt><dd>GitHub からのクローンや新規作成から、そのままプロジェクトを始められます。</dd></div>
					<div><dt>Backlog</dt><dd>ストーリー・タスク・バグを管理。リポジトリの専用ブランチに保存されます。</dd></div>
					<div><dt>Subagent</dt><dd>Claude Code や OpenCode に、別の作業を並行して依頼します。</dd></div>
				</dl>
			</section>

			<section class="factory wrap">
				<div class="factory-head">
					<h2>定型の開発フローは、Factory に任せる</h2>
					<p>
						Backlog のタスクを Factory に渡すと、次の流れを1件ずつ自動で進めます。複数のタスクを同時に流すこともでき、main へのマージは順番に行われます。人が対応するのは、テストが通らない・コンフリクトが解消できないなど、処理が止まったときだけです。
					</p>
				</div>
				<ol class="flow">
					<li><b>worktree の作成</b><span>タスクごとに作業用のブランチを用意</span></li>
					<li><b>実装</b><span>サブエージェントがコードを書く</span></li>
					<li><b>テスト</b><span>通らなければ実装に差し戻し</span></li>
					<li><b>レビュー</b><span>別の AI が完了条件と照らして確認</span></li>
					<li><b>マージ</b><span>最新の main に rebase して取り込み</span></li>
				</ol>
				<a class="more" href="/docs/modules/factory/">Factory について</a>
			</section>

			<section class="feature wrap reverse">
				<div class="feature-text">
					<h2>スマートフォンからも、同じように</h2>
					<p>
						画面はスマートフォンに対応していて、ホーム画面に追加すればアプリのように起動できます。外出先で承認だけ済ませる、進み具合を確認して次の指示を出す、といった使い方ができます。
					</p>
					<a class="more" href="/docs/guide/mobile/">スマートフォンで使う</a>
				</div>
				<div class="feature-shot phone">
					<Screen name="mobile" alt="スマートフォンで会話を開いた画面" frame={false} ratio="390 / 844" sizes="360px" />
				</div>
			</section>

			<section class="security wrap">
				<h2>自分のサーバーで動き、プロジェクトごとに隔離</h2>
				<div class="security-grid">
					<div>
						<h3>コンテナによる隔離</h3>
						<p>プロジェクトごとにコンテナを作成し、AI によるコマンド実行やファイル操作はその中で行われます。メモリ・CPU・プロセス数の上限もプロジェクト単位で設定されます。</p>
					</div>
					<div>
						<h3>シークレットを AI に見せない</h3>
						<p>トークンや鍵は Vault で管理し、AI には参照名だけを渡します。値はコマンドの実行時に直接渡されるため、会話の履歴にも残りません。</p>
					</div>
					<div>
						<h3>パスキーでログイン</h3>
						<p>パスワードは使いません。スマートフォンなどの端末は、ログイン済みの端末に表示される QR コードから追加できます。</p>
					</div>
					<div>
						<h3>別のサーバーでも実行</h3>
						<p>仮想化支援が必要な作業などのために、SSH で接続した別のサーバーをプロジェクトの実行環境にすることもできます。</p>
					</div>
				</div>
			</section>

			<section class="fit wrap" id="fit">
				<div class="fit-head">
					<h2>banto が向いている場合・向いていない場合</h2>
					<p>
						banto は Claude Code の代わりではなく、Claude Code を中で動かし、複数の作業をまとめて管理するためのツールです。作業のしかたによっては、ほかのツールのほうが合うこともあります。
					</p>
				</div>
				<div class="fit-grid">
					<div class="fit-col good">
						<h3>向いている場合</h3>
						<ul>
							<li><b>複数の作業やプロジェクトを同時に AI に任せたい</b><span>ターミナルやウィンドウを行き来して、確認待ちを取りこぼしている</span></li>
							<li><b>自分のサーバーで動かしたい</b><span>コードや開発環境を自宅や社内のサーバーに置きたい</span></li>
							<li><b>パソコンから離れても作業を進めたい</b><span>外出先のスマートフォンから承認したり、次の指示を出したりしたい</span></li>
							<li><b>AI に安心して権限を渡したい</b><span>プロジェクトごとに隔離し、トークンの値は AI に見せずに渡したい</span></li>
							<li><b>開発の周辺までまとめて任せたい</b><span>開発サーバーの起動、ブラウザでの確認、タスクの実装からマージまで</span></li>
						</ul>
					</div>
					<div class="fit-col bad">
						<h3>ほかのツールが合う場合</h3>
						<ul>
							<li><b>1つの作業を、エディターでコードを見ながら進めたい</b><span>Cursor などのエディター型や、エディターの拡張機能が向いています</span></li>
							<li><b>サーバーを用意せず、すぐに試したい</b><span>Claude Code や Codex を手元のパソコンやクラウドで使うほうが手軽です</span></li>
							<li><b>チームで使いたい</b><span>banto は現在、1人で使うことを前提にしています</span></li>
							<li><b>会話に Claude 以外のモデルを使いたい</b><span>会話は Claude だけに対応しています（サブエージェントには OpenCode を使えます）</span></li>
							<li><b>Mac や Windows の上で直接作業させたい</b><span>Xcode を使う開発など。banto の AI は Linux のコンテナの中で作業します</span></li>
						</ul>
					</div>
				</div>
				<a class="more" href="/docs/compare/">ほかのツールとの比較を見る</a>
			</section>

			<section class="install wrap" id="install">
				<div class="install-head">
					<h2>インストール</h2>
					<p>Ubuntu 24.04 または 26.04 のサーバーに、コマンド1つでインストールできます。</p>
				</div>
				<ol class="steps">
					<li>
						<h3>サーバーとドメイン名を用意する</h3>
						<p>仮想マシンでも構いません。banto に割り当てるドメイン名（例：<code>banto.example.com</code>）を決めておきます。Cloudflare で管理しているドメインなら、DNS と証明書の設定も自動で行えます。</p>
					</li>
					<li>
						<h3>インストールコマンドを実行する</h3>
						<p>sudo 権限のあるユーザーで実行します。</p>
						<div class="cmd">
							<code id="install-cmd">{installCmd}</code>
							<button type="button" data-copy-target="install-cmd">コピー</button>
						</div>
					</li>
					<li>
						<h3>ログインしてパスキーを登録する</h3>
						<p>完了時に表示されるリンクを開いてログインし、「設定」→「ログイン」でパスキーを登録します。</p>
					</li>
				</ol>
				<p class="install-note">
					AI との会話には Claude のアカウント（Claude Code）が必要です。詳しくは<a href="/docs/install/">インストールガイド</a>を参照してください。
				</p>
			</section>

			<section class="faq wrap">
				<h2>よくある質問</h2>
				<div class="faq-list">
					{
						faqs.map((f) => (
