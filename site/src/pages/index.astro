		<script>
			// 見出しの案を ?v= で切り替える（検討用）
			{
				const v = new URLSearchParams(location.search).get('v');
				if (v && document.querySelector(`.variant[data-v="${v}"]`)) {
					for (const el of document.querySelectorAll<HTMLElement>('.variant')) el.hidden = el.dataset.v !== v;
				}
			}
			async function copy(btn: HTMLElement, text: string, labelEl: HTMLElement) {
				const original = labelEl.textContent;
				try {
					await navigator.clipboard.writeText(text);
					labelEl.textContent = 'コピーしました';
				} catch {
					labelEl.textContent = 'コピーできませんでした';
				}
				setTimeout(() => (labelEl.textContent = original), 1800);
			}
			for (const btn of document.querySelectorAll<HTMLElement>('[data-copy]')) {
				const label = btn.querySelector<HTMLElement>('.copy-label') ?? btn;
				btn.addEventListener('click', () => copy(btn, btn.dataset.copy ?? '', label));
			}
			for (const btn of document.querySelectorAll<HTMLElement>('[data-copy-target]')) {
				btn.addEventListener('click', () =>
					copy(btn, document.getElementById(btn.dataset.copyTarget ?? '')?.textContent ?? '', btn),
				);
			}
		</script>

