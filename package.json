{
  "name": "banto",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --import tsx --test tests/acceptance/*.spec.ts",
    "build": "tsc -b",
