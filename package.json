{
  "name": "banto",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev:host & npm run dev:web",
    "dev:host": "node --import tsx packages/banto-host/src/bin.ts serve",
    "dev:web": "npm --prefix packages/banto-web run dev",
    "build": "tsc -b",
    "build:web": "npm --prefix packages/banto-web run build",
    "typecheck": "tsc --project tsconfig.check.json",
    "typecheck:web": "tsc --project packages/banto-web/tsconfig.json",
    "test": "BANTO_WORKER_POOL_URL=http://127.0.0.1:1/api/worker-pool BANTO_ENV_POOL_URL=http://127.0.0.1:1/api/environment-pool node --import tsx --test $(ls tests/acceptance/*.spec.ts | grep -vE 'env-docker-|env-driver-contract|env-driver-timeout-budget|env-orphan-ownership|env-profile-setup')",
    "test:docker": "BANTO_WORKER_POOL_URL=http://127.0.0.1:1/api/worker-pool BANTO_ENV_POOL_URL=http://127.0.0.1:1/api/environment-pool node --import tsx --test tests/acceptance/env-docker-rebuild.spec.ts tests/acceptance/env-docker-run.spec.ts tests/acceptance/env-docker-teardown-list.spec.ts tests/acceptance/env-driver-contract.spec.ts tests/acceptance/env-driver-timeout-budget.spec.ts tests/acceptance/env-orphan-ownership.spec.ts tests/acceptance/env-profile-setup.spec.ts",
    "test:e2e": "BANTO_WORKER_POOL_URL=http://127.0.0.1:1/api/worker-pool BANTO_ENV_POOL_URL=http://127.0.0.1:1/api/environment-pool node --import tsx --test --test-concurrency=1 tests/e2e/*.spec.ts",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.1",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  }
}
