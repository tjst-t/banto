{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@banto/core": ["./packages/banto-core/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "tests/**/*.ts"
  ]
}
