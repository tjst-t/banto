# Kobo（統治基盤）を常駐させる。番頭ホスト（banto.service）と同じ checkout から動かす。
#
# **既定では 127.0.0.1 しか待ち受けない**（決定40・task-0061）。この口は認証を持たず、
# 状態遷移も監査判定も受ける——外に出すなら前段（Caddy 等）で守ること。
#
# 前提:
#   - ubuntu ユーザの ghq チェックアウトで npm install を済ませてある
#   - /var/lib/banto/data を ubuntu が読み書きできる

[Unit]
Description=banto daemon (Kobo) — 統治基盤
Documentation=https://github.com/tjst-t/banto
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ghq/github.com/tjst-t/banto

Environment=NODE_ENV=production
Environment=BANTO_PORT=4500
Environment=BANTO_DATA_DIR=/var/lib/banto/data
# 待ち受けは既定（127.0.0.1）のまま。広げるときだけ次を足す（起動ログに警告が出る）
#   Environment=BANTO_DAEMON_BIND=0.0.0.0

# 能力はモジュールから借りる（ADR-0013 決定60）。Kobo は職人も検証環境も自分で持たず、
# それぞれの到達先を1つ知っているだけでよい（決定27b：呼び出しは当事者間で直接）。
#
# **いまは番頭ホスト（:4100）の口を指す。** 独立サービス（banto-worker-pool /
# banto-environment-pool）も用意してあるが、**番頭ホストがまだ自分の中に両方を作る**ため、
# そちらへ向けると台帳が2つに割れる（inc-0027 と同じ形）。番頭ホストが独立サービスの
# 利用者になったら、この2行を 4300 / 4400 へ差し替える。
# **直に叩く**（決定27：Banto をブローカーにしない）。番頭ホスト経由だと、
# Kobo が職人を起こすのに番頭の稼働が要る——決定27b が避けた依存の逆転そのもの
Environment=BANTO_WORKER_POOL_URL=http://127.0.0.1:4300/api/worker-pool
Environment=BANTO_ENV_POOL_URL=http://127.0.0.1:4400/api/environment-pool

ExecStart=/usr/local/bin/node --import tsx packages/banto-daemon/src/index.ts

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# **KillMode は control-group にしない。** 職人は Worker Pool 側の子プロセスなので
# Kobo の巻き添えでは畳まないが、Kobo 自身の後始末（イベントログの書き切り）に猶予がいる
KillMode=mixed
TimeoutStopSec=30

NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/banto /home/ubuntu/ghq /home/ubuntu/worktrees

[Install]
WantedBy=multi-user.target
