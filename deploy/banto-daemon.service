[Unit]
Description=banto daemon — HTTP API + WebSocket orchestration server
Documentation=https://github.com/tjst-t/banto
After=network.target

[Service]
Type=simple
User=banto
Group=banto
WorkingDirectory=/opt/banto/current
ExecStart=/usr/bin/node --import tsx packages/banto-daemon/src/index.ts
Restart=on-failure
RestartSec=5s

# Configuration via environment variables
# BANTO_PORT defaults to 3000
Environment=BANTO_PORT=3000
# BANTO_DATA_DIR defaults to ./data
Environment=BANTO_DATA_DIR=/var/lib/banto/data

# 能力はモジュールから借りる（ADR-0013 決定60）。Kobo は職人も検証環境も自分で持たず、
# それぞれの到達先を1つ知っているだけでよい（決定27b：呼び出しは当事者間で直接）。
#   BANTO_WORKER_POOL_URL 既定 http://127.0.0.1:4100/api/worker-pool
#     ——Worker Pool はいまのところ番頭ホスト（banto.service）に同居している。
#       独立サービスにするまでは、Kobo は banto.service が動いていないと職人を起こせない
#   BANTO_ENV_POOL_URL    既定 http://127.0.0.1:4400/api/environment-pool（別ユニット）

# Graceful shutdown: systemd sends SIGTERM, daemon handles it
TimeoutStopSec=30

# Security hardening (local server, no internet exposure)
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/banto

[Install]
WantedBy=multi-user.target
