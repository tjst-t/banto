# 検証環境（Environment Pool）を独立プロセスとして常駐させる（ADR-0013 決定61）。
#
# なぜ番頭ホストと分けるか:
#   Kobo も番頭も、このサービスのクライアントになる（決定27b）。番頭ホストの中に
#   置いたまま Kobo から叩くと、**Kobo が番頭の稼働に依存する**——決定27b が
#   「Banto が単一障害点になり、依存の向きが逆転する」として避けた状態そのもの。
#
# **既定では 127.0.0.1 しか待ち受けない**（決定40a）。このサービスは sops の復号鍵を
# 持つため、無認証の面を外に出すと credentials 経路が露出する。外から届かせたい場合は
# 前段（Caddy 等）から 127.0.0.1:4400 へ中継すること。
#
# 前提:
#   - ubuntu ユーザの ghq チェックアウトで npm install を済ませてある
#   - /var/lib/banto を ubuntu が読み書きできる（番頭ホストと同じ置き場を使う）
#   - credentials 付きプロファイルを使うなら SOPS_AGE_KEY_FILE の鍵が読める

# **番頭も Kobo もこのサービスの利用者**（task-0066 で番頭ホストの同居をやめた）。
# 台帳と回収した成果物（/var/lib/banto/environment-pool）は番頭ホストが使っていたものを
# そのまま引き継ぐ——番頭は `collected` を場所として読むので、置き場をずらさないこと。
[Unit]
Description=banto environment pool — 検証環境の台帳と実行
Documentation=https://github.com/tjst-t/banto
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ghq/github.com/tjst-t/banto

Environment=NODE_ENV=production
Environment=BANTO_ENV_POOL_DATA=/var/lib/banto/environment-pool
Environment=BANTO_ENV_POOL_PORT=4400
# 復号鍵を持つのはこのサービスだけ（決定32d）。番頭にも Kobo にも渡さない
# Environment=SOPS_AGE_KEY_FILE=/home/ubuntu/.config/sops/age/keys.txt

ExecStart=/usr/local/bin/node --import tsx packages/banto-environment-pool/src/bin.ts serve

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# --- OOM 封じ込め（inc-0066 / 2026-08-14）------------------------------------
# 根拠: reports/2026-08-14-oom-containment-plan.md
#       reports/2026-08-16-oom-host-facts.md
#       ※ 置き場は /home/ubuntu/banto-desk/reports/
#
# **検証環境の台帳を、工房の暴走から守るための枠。**
#   MemoryMax=1G     実測 MemoryCurrent 0.13GB / peak 0.19GB
#   MemoryMin=256M   この分は回収対象から外れる。
#                    **親の system.slice の MemoryMin が無いと黙って効かない**
#                    （deploy/system.slice.d/oom.conf）
#   OOMScoreAdjust=-500  global OOM でカーネルが検証環境を最後に選ぶ
#
# 注意: この上限が効くのはこのサービス自身の cgroup であって、docker ドライバが
# 起こすコンテナは dockerd 側の cgroup に入る（この 1G には数えられない）。
MemoryAccounting=yes
MemoryMax=1G
MemoryMin=256M
OOMScoreAdjust=-500

NoNewPrivileges=true
# 検証環境のドライバ（docker / process）が /tmp を使うので PrivateTmp は無効のまま
PrivateTmp=false
ProtectSystem=full
ReadWritePaths=/var/lib/banto /home/ubuntu/ghq/github.com/tjst-t/banto

[Install]
WantedBy=multi-user.target
