# 番頭ホスト（Banto）を常駐させる。単一インスタンス運用（開発＝本番）。
#
# 前提:
#   - ubuntu ユーザの ghq チェックアウト（/home/ubuntu/ghq/github.com/tjst-t/banto）で
#     npm install と npm run build:web を済ませてある
#   - /var/lib/banto は ubuntu が読み書きできる（データはコードの場所と独立）
#   - ~ubuntu/.pi/agent/auth.json に LLM の認証がある（chmod 600）
#
# **既定では 127.0.0.1 しか待ち受けない**（Banto は認証を持たないため）。
# 外に出すときは前段（Caddy 等）から 127.0.0.1:4100 へ中継すること。
# 前段を置かずに直接公開したい場合だけ BANTO_HOST_BIND を広げる（自己責任）。

[Unit]
Description=banto (番頭) host
Documentation=https://github.com/tjst-t/banto
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ghq/github.com/tjst-t/banto

Environment=NODE_ENV=production
Environment=BANTO_DATA_DIR=/var/lib/banto
Environment=BANTO_PROVIDER=opencode
Environment=BANTO_MODEL=deepseek-v4-flash-free
# 番頭が書けるのはこのチェックアウトの docs/** と work/** のみ
Environment=BANTO_PLACES=banto:/home/ubuntu/ghq/github.com/tjst-t/banto:docs/**,work/**
# Kobo の帳簿（決定63）。**どの設定でも番頭に書かせない**——場所として登録されても届かない。
# banto-daemon.service の BANTO_DATA_DIR と同じ値にすること（起動ログで守れているか分かる）
Environment=BANTO_KOBO_DATA_DIR=/var/lib/banto/data
# 工房と検証環境は**独立サービス**（task-0066・決定61）。番頭はその利用者で、
# 自分の中には作らない——既定と同じ値だが、どこを見ているかを明示しておく。
# 立っていないと委譲（worker.*）と検証（env.*）が失敗する（起動ログに出る）
Environment=BANTO_WORKER_POOL_URL=http://127.0.0.1:4300/api/worker-pool
Environment=BANTO_ENV_POOL_URL=http://127.0.0.1:4400/api/environment-pool
# 回収した成果物を番頭が読めるように、検証環境サービスと同じ置き場を教える
# （banto-environment-pool.service の BANTO_ENV_POOL_DATA と同じ値にすること）
Environment=BANTO_ENV_POOL_DATA=/var/lib/banto/environment-pool

ExecStart=/usr/local/bin/node --import tsx packages/banto-host/src/bin.ts serve --port 4100

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full
ReadWritePaths=/var/lib/banto /home/ubuntu/ghq/github.com/tjst-t/banto

[Install]
WantedBy=multi-user.target
