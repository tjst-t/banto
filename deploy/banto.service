# 番頭ホスト（Banto）を常駐させる。単一インスタンス運用（開発＝本番）。
#
# 前提:
#   - ubuntu ユーザの ghq チェックアウト（/home/ubuntu/ghq/github.com/tjst-t/banto）で
#     npm install と npm run build:web を済ませてある
#   - /var/lib/banto は ubuntu が読み書きできる（データはコードの場所と独立）
#   - ~ubuntu/.pi/agent/auth.json に LLM の認証がある（chmod 600）
#
# **既定では 127.0.0.1 しか待ち受けない**（Banto は認証を持たないため）。
# 外に出すときは前段（Caddy 等）から 127.0.0.1:4100 へ中継すること。
# 前段を置かずに直接公開したい場合だけ BANTO_HOST_BIND を広げる（自己責任）。

[Unit]
Description=banto (番頭) host
Documentation=https://github.com/tjst-t/banto
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ghq/github.com/tjst-t/banto

Environment=NODE_ENV=production
Environment=BANTO_DATA_DIR=/var/lib/banto
# BANTO_PROVIDER / BANTO_MODEL は**読まれない**（2026-08-04 の裁定で env の読み取りを
# やめた。2026-08-13 に実地で確認）。モデルは設定画面と会話のモデル選択から変える
# 番頭が書けるのはこのチェックアウトの docs/** と work/** のみ
Environment=BANTO_PLACES=banto:/home/ubuntu/ghq/github.com/tjst-t/banto:docs/**,work/**
# Kobo の帳簿（決定63）。**どの設定でも番頭に書かせない**——場所として登録されても届かない。
# banto-daemon.service の BANTO_DATA_DIR と同じ値にすること（起動ログで守れているか分かる）
Environment=BANTO_KOBO_DATA_DIR=/var/lib/banto/data
# 工房と検証環境は**独立サービス**（task-0066・決定61）。番頭はその利用者で、
# 自分の中には作らない——既定と同じ値だが、どこを見ているかを明示しておく。
# 立っていないと委譲（worker.*）と検証（env.*）が失敗する（起動ログに出る）
Environment=BANTO_WORKER_POOL_URL=http://127.0.0.1:4300/api/worker-pool
Environment=BANTO_ENV_POOL_URL=http://127.0.0.1:4400/api/environment-pool
# 回収した成果物を番頭が読めるように、検証環境サービスと同じ置き場を教える
# （banto-environment-pool.service の BANTO_ENV_POOL_DATA と同じ値にすること）
Environment=BANTO_ENV_POOL_DATA=/var/lib/banto/environment-pool

ExecStart=/usr/local/bin/node --import tsx packages/banto-host/src/bin.ts serve --port 4100

# **always でなければならない**（inc-0072）。`system.restart` は自分を落として systemd に
# 拾わせる道具で、その終わり方は `exit(0)`＝正常終了である（packages/banto-host/src/restart-tool.ts）。
# 正常終了での自己再起動が設計上の前提なので、`on-failure` にすると**撃った瞬間に
# banto が上がってこない**——しかも撃つまで分からない。終了コードを変えるのではなく
# ここを always にする、が 2026-08-16 の裁定。
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# --- OOM 封じ込め（inc-0066 / 2026-08-14）------------------------------------
# 根拠: reports/2026-08-14-oom-containment-plan.md（値の導出と却下した案）
#       reports/2026-08-16-oom-host-facts.md（入った後の実測と kill の一次記録）
#       ※ 置き場は /home/ubuntu/banto-desk/reports/
#
# 2026-08-14 00:27 UTC、職人が起こした claude CLI 1本が anon-rss 10.7GiB に膨らみ、
# 15.62GiB の VM が **global OOM** で停止した。上限が1つも無かったのが原因。
# 入れた後は、カーネルの OOM kill が**全件 cgroup 上限に当たったもの**
# （constraint=CONSTRAINT_MEMCG）になり、VM 全体の枯渇は 1件も起きていない。
#
# 番頭を巻き添えにしないための3点セット:
#   MemoryMax=3G      実測 MemoryCurrent 1.90GB / peak 1.92GB の約1.6倍
#   MemoryMin=1G      この分は回収対象から外れる。
#                     **親の system.slice にも MemoryMin が要る**——cgroup v2 は
#                     親に無い保護を子に配れないので、無いとこの行は黙って効かない
#                     （deploy/system.slice.d/oom.conf）
#   OOMScoreAdjust=-500  万一の global OOM でカーネルが番頭を最後に選ぶ
#
# 上限の総和: OS 1.5G + 番頭 3G + Kobo 1G + 検証環境 1G + 工房 9G = 15.5GiB < 15.62GiB
#
# **稼働機には 2026-08-16 時点で `systemctl set-property --runtime` の一時の上限が
# 乗っている**（banto 5G / banto-worker-pool 7G。/run/systemd/system.control/ 以下）。
# あれは凌ぎであって恒久の値ではない。ここに書いてあるのが恒久の側。
# --runtime の drop-in はサービス再起動では消えないが、**機械の再起動で消える**。
MemoryAccounting=yes
MemoryMax=3G
MemoryMin=1G
OOMScoreAdjust=-500

NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full
ReadWritePaths=/var/lib/banto /home/ubuntu/ghq/github.com/tjst-t/banto

[Install]
WantedBy=multi-user.target
