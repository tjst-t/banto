# 職人（Worker Pool）を独立プロセスとして常駐させる（ADR-0010 決定27b・ADR-0013 決定61 の同型）。
#
# **なぜ独立させるか。** 同居していると Kobo が職人を起こすのに番頭ホストの稼働を必要とし、
# 決定27b が避けた「Banto が単一障害点／依存の向きが逆転する」形になる。
#
# 前提:
#   - /var/lib/banto は ubuntu が読み書きできる
#   - ~ubuntu/.pi/agent/auth.json に LLM の認証がある（職人は pi で動く）
#
# **既定では 127.0.0.1 しか待ち受けない**（決定40）。この口は**任意のディレクトリで
# 任意のコマンドを実行できる職人**を起こせるので、外に出さないこと。

# **番頭も Kobo もこのサービスの利用者**（task-0066 で番頭ホストの同居をやめた）。
# 台帳（/var/lib/banto/worker-pool）は番頭ホストが使っていたものをそのまま引き継ぐ
# ——落ちる前に生きていた職人は、このサービスが起こし直す（決定44）。
[Unit]
Description=banto worker pool (職人)
Documentation=https://github.com/tjst-t/banto
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ghq/github.com/tjst-t/banto

Environment=NODE_ENV=production
Environment=BANTO_WORKER_POOL_PORT=4300
Environment=BANTO_WORKER_POOL_DATA=/var/lib/banto/worker-pool
# **番頭ホストと同じ値にすること**（ADR-0004）。tier→モデルの台帳
# （<BANTO_DATA_DIR>/llm-registry.json）を共有しないと、画面で選んだモデルが職人に効かない
Environment=BANTO_DATA_DIR=/var/lib/banto
# 職人の既定モデル（省略すると pi の既定解決）。等級の解決はここが持つ（決定60a）
# Environment=BANTO_WORKER_PROVIDER=opencode
# Environment=BANTO_WORKER_MODEL=deepseek-v4-flash-free

ExecStart=/usr/local/bin/node --import tsx packages/banto-worker-pool/src/bin.ts serve

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# --- OOM 封じ込め（inc-0066 / 2026-08-14）------------------------------------
# 根拠: reports/2026-08-14-oom-containment-plan.md（値の導出と却下した案）
#       reports/2026-08-14-oom-stage2-addendum-cgroup-v2.md（第2段＝職人1本ごとの隔離）
#       reports/2026-08-16-oom-host-facts.md（入った後の実測と kill の一次記録）
#       ※ 置き場は /home/ubuntu/banto-desk/reports/
#
# **ここが事故の震源**。2026-08-14 に工房の下の claude CLI 1本が 10.7GiB まで膨らみ、
# VM ごと落とした。**上限を1つも持っていなかった**のが原因。
#
# 第1段: 工房 unit 全体の上限
#   OOMPolicy=continue   **これが被害を9倍にしていた。** 既定の stop は、cgroup 内で
#                        1本が OOM kill されると unit ごと畳む——事故当時、暴れたのは
#                        1本で、道連れにされた他の8本は正常だった。continue なら
#                        暴れた1本だけが死に、残りは生き続ける
#   MemoryMax=8G         **2026-08-16 に 9G から引き下げた（inc-0077）。**
#                        番頭を 3G → 5G に上げた分をここから引いている。理由は総和:
#                        番頭 5G + 工房 8G + Kobo 1G + 検証環境 1G =
#                        **15 GiB ≦ MemTotal 15.6 GiB**。
#                        **工房を 9G のままにすると 16 GiB になり、MemTotal を超える。**
#                        上限は予約ではないので普段は動くが、4つが同時に上限近くまで
#                        伸びた瞬間に **VM ごと死ぬ**（2026-08-14 の global OOM がその形）。
#                        **「職人1本あたり」ではなく「工房全体」の上限**。
#                        4G だと今すぐ破綻する（実測 4.43GB）。
#                        旧根拠: 実測 平常 4.43GB / 本 boot の peak 7.94GB / 事故時 13.0GB、
#                        導出は 15.62GiB − OS 1.5G − 番頭 3G − Kobo 1G − 検証環境 1G
#                        = 9.1GiB → 切り下げて 9G（番頭が 3G だった頃の内訳）
#   OOMScoreAdjust=500   万一の global OOM でカーネルが**まず職人を選ぶ**。
#                        子（node → claude）に spawn 時に継承される
#   TasksMax=2048        プロセス数の暴走も止める（実測 299。既定 19145 は実質無制限）
#
# 第2段: 職人1本ごとの cgroup 隔離（packages/banto-worker-pool/src/worker-cgroup.ts）
#   Delegate=yes / DelegateSubgroup=supervisor で、工房本体を supervisor/ に退避させ、
#   その隣に職人ごとの子 cgroup を工房自身が切れるようにする（cgroup v2 の
#   「内部ノードにプロセスを置けない」制約を避ける形）。BANTO_WORKER_CGROUP=auto で有効化。
#   これで 1本の暴走が 2G で止まり、8G の unit 上限まで到達しなくなる
#   （unit の 8G は最終の防波堤として残す）
#
# **8G で足りる、とは書かない。** 2026-08-16 の実測では**工房は 8G でも落ちている**
# （memory.events の oom_kill が 116 → 139）。この値の改訂は総和を MemTotal に収め、
# 「**もう当たっている状態を解く**」ためのもので、根治ではない。根治は次の3本:
#   task-0186  検証を袋の外で回し、結果も切り詰める
#   task-0165  アイドルな会話のセッションを畳む
#   task-0168  同時に走る職人の本数の上限
#
# **恒久側（ここと /etc/systemd/system/<unit>.d/oom.conf）が古いままだと、
# `--runtime` の一時の上限が消えるたびに再発する。** drop-in は同じキーなら後勝ちで、
# 適用順は /run/systemd/system.control/... （--runtime＝一時）が先、
# /etc/systemd/system/<unit>.service.d/oom.conf（恒久）が後＝**勝つ**。
# 実際 2026-08-16 06:34:58 の `systemctl daemon-reload` の1秒後、番頭では一時の 5G が
# 恒久の 3G に上書きされて OOM した（inc-0077）。**/run にファイルが残っていても
# 効いていない**——「ファイルが在る＝効いている」ではない。
# --runtime の drop-in はサービス再起動では消えないが、**機械の再起動で消える**。
OOMPolicy=continue
MemoryAccounting=yes
MemoryMax=8G
OOMScoreAdjust=500
TasksMax=2048
Delegate=yes
DelegateSubgroup=supervisor
Environment=BANTO_WORKER_CGROUP=auto
Environment=BANTO_WORKER_MEMORY_MAX=2G

# **KillMode は control-group にしない。** 職人は子プロセスとして生きており、
# 決定44 で「落ちる前に生きていた職人は起こし直す」と決めている——巻き添えで畳むと
# 再起動のたびに実作業が消える
KillMode=mixed
TimeoutStopSec=30

NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/banto /home/ubuntu/ghq /home/ubuntu/worktrees

[Install]
WantedBy=multi-user.target
